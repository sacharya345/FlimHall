{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "FlimHall: Start frontend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"client",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "FlimHall: Start backend",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"dev",
				"--prefix",
				"server"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "FlimHall: Run backend server",
			"type": "shell",
			"command": "node",
			"args": [
				"server/src/server.js"
			],
			"isBackground": true,
			"problemMatcher": [],
			"group": "build"
		}
	]
}